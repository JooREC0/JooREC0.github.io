---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
interface Props { title?: string; description?: string; noindex?: boolean; article?: boolean }
const { title = SITE_TITLE, description = SITE_DESCRIPTION, noindex = false, article = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const nav = [['/', 'Home'], ['/about/', 'About'], ['/projects/', 'Projects'], ['/research/', 'Research'], ['/blog/', 'Blog']];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171d24" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href="/rss.xml" />
    <meta property="og:title" content={title === SITE_TITLE ? SITE_TITLE : `${title} · ${SITE_TITLE}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <title>{title === SITE_TITLE ? SITE_TITLE : `${title} · ${SITE_TITLE}`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="JooREC0 홈">{SITE_TITLE}<span class="brand-divider" aria-hidden="true">/</span></a>
        <nav aria-label="주 메뉴">{nav.map(([href, label]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav>
        <a class="header-github" href={GITHUB_URL}>GitHub</a>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell site-footer">
      <p>© {new Date().getFullYear()} {SITE_TITLE}<span>개인 포트폴리오 · 기술 블로그</span></p>
      <div><a href={GITHUB_URL}>GitHub</a><a href="/rss.xml">RSS</a><a href="/admin/">글쓰기</a></div>
    </footer>
  </body>
</html>
