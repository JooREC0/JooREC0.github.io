---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { GITHUB_URL } from '../consts';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
---
<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">PERSONAL PORTFOLIO & TECH NOTES</p>
      <h1>배운 것을,<br />다시 꺼내 볼 수 있게<span class="accent">.</span></h1>
      <p class="hero-description">JooREC0의 개인 공간.<br />학습과 작업의 과정을 차근차근 기록합니다.</p>
      <div class="hero-links"><a class="button" href="/blog/">기록 둘러보기</a><a class="text-link" href={GITHUB_URL}>GitHub 프로필</a></div>
    </div>
    <aside class="index-note" aria-label="사이트 구성">
      <p class="note-label">IN THIS SPACE</p>
      <a href="/about/"><span>About</span><span>소개와 관심 분야</span></a>
      <a href="/projects/"><span>Projects</span><span>만든 것과 작업 과정</span></a>
      <a href="/research/"><span>Research</span><span>질문과 탐구 기록</span></a>
      <a href="/blog/"><span>Blog</span><span>배움과 생각</span></a>
      <p class="note-bottom">작은 기록부터 시작합니다.</p>
    </aside>
  </section>
  <section class="latest-section" aria-labelledby="latest-heading">
    <div class="section-heading"><div><p class="eyebrow">RECENT NOTES</p><h2 id="latest-heading">최근 기록</h2></div><a class="text-link" href="/blog/">모든 글 보기</a></div>
    {posts.length ? <PostList posts={posts} /> : <div class="empty-state"><span class="empty-symbol" aria-hidden="true">[ ]</span><div><h3>첫 번째 기록을 준비하고 있어요.</h3><p>글이 발행되면 이곳에서 최근 기록을 볼 수 있습니다.</p></div></div>}
  </section>
</Layout>
