---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { GITHUB_URL, SITE_REPO, SITE_TITLE } from '../consts';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
---
<Layout>
  <section class="profile-intro" aria-labelledby="profile-title">
    <p class="eyebrow">WORK / CONTEXT / EVIDENCE</p>
    <h1 id="profile-title">{SITE_TITLE}</h1>
    <p class="intro-statement">작업, 역할, 근거를 함께.</p>
    <p class="intro-description">만든 것과 판단의 과정을 기록합니다.<br class="desktop-break" /> 설명에서 코드와 원문까지 이어지는 개인 포트폴리오.</p>
    <div class="intro-links"><a href="/about/">소개</a><a href={GITHUB_URL}>GitHub 프로필</a></div>
  </section>

  <section class="featured-work" aria-labelledby="project-title">
    <div class="section-heading project-heading"><p class="eyebrow">PROJECT IN FOCUS</p><span class="project-type">개인 웹사이트</span></div>
    <div class="project-summary"><h2 id="project-title">개인 포트폴리오와<br class="desktop-break" /> 기술 블로그</h2><p>코드와 글을 GitHub에 보관하고,<br class="desktop-break" /> 웹에서 작성한 글을 자동으로 배포하는 개인 공간.</p></div>
    <dl class="project-facts">
      <div><dt>목적</dt><dd>작업과 학습 기록을 한곳에 정리</dd></div>
      <div><dt>담당 작업</dt><dd>사이트 구성 · 배포 · 발행 흐름 확인</dd></div>
      <div><dt>기술</dt><dd>Astro · Markdown/MDX · Sveltia CMS</dd></div>
      <div><dt>배포</dt><dd>GitHub Actions · GitHub Pages</dd></div>
    </dl>
    <div class="project-evidence"><p class="evidence-label">SOURCE & DOCUMENTATION</p><div class="evidence-links"><a href={SITE_REPO}>GitHub 원문</a><a href={`${SITE_REPO}/actions`}>자동 배포 기록</a><a href={`${SITE_REPO}/blob/main/WRITING_GUIDE.md`}>글쓰기 가이드</a></div><p class="source-path">JooREC0 / JooREC0.github.io</p></div>
  </section>

  <div class="home-sections">
    <section class="research-summary" aria-labelledby="research-heading"><div class="section-heading"><h2 id="research-heading">연구 기록</h2><a class="text-link" href="/research/">Research</a></div><div class="research-placeholder"><h3>질문에서 근거까지</h3><p>질문, 접근 방법, 확인한 내용과 한계를 함께 정리할 공간입니다.</p><p class="preparing-note">탐구 기록을 준비하고 있습니다.</p></div></section>
    <section class="latest-notes" aria-labelledby="latest-heading"><div class="section-heading"><h2 id="latest-heading">최근 글</h2><a class="text-link" href="/blog/">모든 글 보기</a></div>{posts.length ? <PostList posts={posts} headingLevel="h3" /> : <div class="empty-state"><div><h3>첫 번째 기록을 준비하고 있어요.</h3><p>글이 발행되면 이곳에 표시됩니다.</p></div></div>}</section>
  </div>
</Layout>
